{
  "name": "journey-extension",
  "displayName": "Journey Extension",
  "description": "VSCode extension for creating Journey structures (experience, page, module, step, bloc)",
  "version": "0.0.2",
  "publisher": "AdamLion",
  "repository": {
    "type": "git",
    "url": "https://github.com/chink603/journey-extension.git"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:journey.newExperience",
    "onCommand:journey.newPage",
    "onCommand:journey.newModule",
    "onCommand:journey.newStep",
    "onCommand:journey.newBloc"
  ],
  "contributes": {
    "commands": [
      {
        "command": "journey.newExperience",
        "title": "Experience"
      },
      {
        "command": "journey.newPage",
        "title": "Page"
      },
      {
        "command": "journey.newModule",
        "title": "Journey"
      },
      {
        "command": "journey.newStep",
        "title": "Step"
      },
      {
        "command": "journey.newBloc",
        "title": "Bloc"
      }
    ],
    "submenus": [
      {
        "id": "journey.newMicroJourney",
        "label": "New Micro Journey"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "journey.newMicroJourney",
          "group": "navigation@10",
          "when": "explorerResourceIsFolder"
        }
      ],
      "journey.newMicroJourney": [
        {
          "command": "journey.newExperience",
          "group": "1@1"
        },
        {
          "command": "journey.newPage",
          "group": "1@2"
        },
        {
          "command": "journey.newModule",
          "group": "1@3"
        },
        {
          "command": "journey.newStep",
          "group": "1@4"
        },
        {
          "command": "journey.newBloc",
          "group": "1@5"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "pack": "vsce package",
    "pack:out": "vsce package --out",
    "install:cli": "code --install-extension $(ls *.vsix | head -n 1) --force"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  }
}
